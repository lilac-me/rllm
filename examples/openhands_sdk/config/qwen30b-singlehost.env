# =============================================================================
# pqy single-host (16-NPU)  —  Qwen3-Coder-30B-A3B × OpenHands × Triton
#
# Trainer:    NPU 0-7   (in dev container, host-network mode)
# Worker:     remote_eval_worker.py on the *host* (NOT in dev container)
# OpenHands:  NPU 8-15  (file-locked under /tmp/shared_npu_lock)
#
# Why a worker even though single-host:
#   DooD (docker.sock mounted into dev container) means trainer's `-v` paths
#   refer to dev-container fs, but host dockerd looks them up on host fs and
#   auto-mkdirs empty placeholders -> OpenHands container's entrypoint.py is
#   missing -> stuck in Created. Routing rollouts through a host-side worker
#   anchors all `-v` source paths on the host filesystem.
#
# Usage:
#   1) On the *host* (not dev container):
#        cp .../examples/openhands_sdk/remote_eval_worker.py /home/docker/
#        mkdir -p /tmp/openhands_workspace
#        python3 /home/docker/remote_eval_worker.py \
#            --host 127.0.0.1 --port 16881 \
#            --work-dir /tmp/openhands_workspace 2>&1 | tee /tmp/oh-worker.log
#
#   2) In the dev container:
#        RLLM_CONFIG_FILE=examples/openhands_sdk/config/qwen30b-singlehost.env \
#          bash examples/openhands_sdk/debug_oom.sh
#
# Dev container is host-network mode (verified: `ip route` shows host LAN),
# so trainer's 127.0.0.1:16881 reaches the host worker directly.
# =============================================================================

# Model & dataset
export MODEL_PATH=/home/docker/Qwen3-Coder-30B-A3B-Instruct
export OPENHANDS_KERNELBENCH_PARQUET=/workspace/rllm-openhands/examples/openhands_sdk/kernelbench_openhands.parquet

# Network — host-network dev container, so 127.0.0.1 reaches host loopback
export TRAIN_HOST_IP=127.0.0.1
export EVAL_WORKER_IP=127.0.0.1
export PROXY_PORT=5000
export EVAL_WORKER_PORT=16881
export NIC_NAME=ens1f3

# OpenHands eval mode: HTTP path (same as multi-host, only worker IP differs)
#   - non-empty REMOTE_EVAL_URL -> openhands_agent.py:626 routes via HTTP
#   - host.docker.internal -> resolved by --add-host in openhands_agent.py:787;
#     OpenHands container uses this to reach the LiteLLM proxy on the host.
export OPENHANDS_REMOTE_EVAL_URL="http://${EVAL_WORKER_IP}:${EVAL_WORKER_PORT}"
export OPENHANDS_CONTAINER_HOST_ALIAS=host.docker.internal

# NPU pool — trainer 0-7 (in dev container), OpenHands 8-15 (in worker-spawned
# containers). MUST be disjoint, else trainer and OpenHands containers fight
# for the same NPU and HCCL deadlocks.
export ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
export OPENHANDS_EVAL_DEVICE_IDS=8,9,10,11,12,13,14,15

# Docker
export OPENHANDS_IMAGE=openhands-triton-env:v1

# Output / log
export RLLM_LOG_DIR=/workspace/results
export TRACE_DB_PATH=/workspace/results/rllm-openhands-traces.db
export OPENHANDS_ARTIFACT_DIR=/workspace/results/openhands_results
export PROFILE_SAVE_PATH=/workspace/results/profile_data/all

# Memory / runtime tuning — 2048 is the confirmed BS=3 OOM fix (was 128 in pqy)
export PYTORCH_NPU_ALLOC_CONF="max_split_size_mb:2048"
export HCCL_BUFFSIZE=64
