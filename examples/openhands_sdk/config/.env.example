# =============================================================================
# OpenHands RL training environment template
#
# Usage:
#   1. Copy this file to qwen30b.env (or <experiment>.env) and fill real values.
#   2. debug_oom.sh will source ${RLLM_CONFIG_FILE:-config/qwen30b.env} on launch.
#   3. Variables NOT in this file (hyper-params: BATCH_SIZE, TP/PP/CP, ROLLOUT_N,
#      profiler toggles) stay inline in the training shell script — they bind
#      tightly to an experiment, not a machine.
# =============================================================================

# -----------------------------------------------------------------------------
# Model & dataset (absolute paths on the training host)
# -----------------------------------------------------------------------------
export MODEL_PATH=/path/to/Qwen3-Coder-30B-A3B-Instruct
export OPENHANDS_KERNELBENCH_PARQUET=/path/to/kernelbench_openhands.parquet
# Optional — defaults inside Python scripts if unset:
# export OPENHANDS_KERNELBENCH_DATASET=/path/to/kernelbench_hf_dataset

# -----------------------------------------------------------------------------
# Network — host IPs, ports, NIC
#   TRAIN_HOST_IP            train machine IP. Used for HCCL_IF_IP.
#   EVAL_WORKER_IP           eval-worker host IP. Listens for trainer HTTP POST.
#                            Unused in single-host mode.
#   PROXY_PORT               LiteLLM proxy port on train host.
#   EVAL_WORKER_PORT         remote_eval_worker.py listen port on eval host.
#                            Unused in single-host mode.
#   NIC_NAME                 NIC for HCCL/GLOO/TP socket binding.
# -----------------------------------------------------------------------------
export TRAIN_HOST_IP=80.48.5.X
export EVAL_WORKER_IP=80.48.5.Y
export PROXY_PORT=5000
export EVAL_WORKER_PORT=16881
export NIC_NAME=ens1fN

# -----------------------------------------------------------------------------
# OpenHands eval mode — single-host vs multi-host
#   OPENHANDS_REMOTE_EVAL_URL     empty -> same-machine `docker run` path
#                                 (openhands_agent.py:626 checks this).
#                                 http://host:port -> remote_eval_worker.py.
#   OPENHANDS_CONTAINER_HOST_ALIAS  hostname/IP the OpenHands container uses to
#                                   reach the LiteLLM proxy on the train host.
#                                   Single-host: host.docker.internal (paired
#                                   with docker --add-host from
#                                   openhands_agent.py:787).
#                                   Multi-host: TRAIN_HOST_IP — MUST be the
#                                   train host, not the eval host (setting it
#                                   to the eval host causes Connection refused;
#                                   see PQY_DEBUG_CONTEXT history).
# -----------------------------------------------------------------------------
export OPENHANDS_REMOTE_EVAL_URL=
export OPENHANDS_CONTAINER_HOST_ALIAS=host.docker.internal

# -----------------------------------------------------------------------------
# NPU pool partitioning
#   ASCEND_RT_VISIBLE_DEVICES    NPUs visible to the rllm trainer.
#   OPENHANDS_EVAL_DEVICE_IDS    NPUs OpenHands containers may use. The
#                                container's evaluator grabs an unused id via
#                                file lock under /tmp/shared_npu_lock.
#                                Single-host 16-NPU layout: trainer on 0-7,
#                                OpenHands on 8-15 (MUST be disjoint).
# -----------------------------------------------------------------------------
export ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
export OPENHANDS_EVAL_DEVICE_IDS=

# -----------------------------------------------------------------------------
# Docker image (built from examples/openhands_sdk/workspace/Dockerfile)
# -----------------------------------------------------------------------------
export OPENHANDS_IMAGE=openhands-triton-env:v1

# -----------------------------------------------------------------------------
# Output / log directories
#   RLLM_LOG_DIR             default base for trainer-side .log files
#                            (used by openhands_agent.py and runner.py when no
#                            specific path is set).
#   TRACE_DB_PATH            sqlite trace store for rllm.sdk.store.
#   OPENHANDS_ARTIFACT_DIR   per-rollout artifact dump.
#   PROFILE_SAVE_PATH        NPU profiler dump directory.
# -----------------------------------------------------------------------------
export RLLM_LOG_DIR=/path/to/logs
export TRACE_DB_PATH=/path/to/rllm-openhands-traces.db
export OPENHANDS_ARTIFACT_DIR=/path/to/openhands_results
export PROFILE_SAVE_PATH=/path/to/profile_data/all

# -----------------------------------------------------------------------------
# Memory / runtime tuning  (HISTORY: BS=3 OOM fix)
#   max_split_size_mb:2048 cut fragmentation tax from ~30GB to ~17GB.
#   Do NOT set expandable_segments:True — it conflicts with vLLM sleep mode
#   (see vllm-ascend/vllm_ascend/device_allocator/camem.py:151).
# -----------------------------------------------------------------------------
export PYTORCH_NPU_ALLOC_CONF="max_split_size_mb:2048"
export HCCL_BUFFSIZE=64

# -----------------------------------------------------------------------------
# Optional debug toggles (all default off)
# -----------------------------------------------------------------------------
# export RLLM_MEM_DEBUG=1          # NPU memory probes in AgentSdkTrainer
# export RLLM_ENGINE_DEBUG=1       # format/padding prints in agent_sdk_engine
# export ASCEND_LAUNCH_BLOCKING=1  # sync NPU launch for stacktrace accuracy
# export OPENHANDS_REMOTE_KEEP_WORKDIR=1  # keep per-rollout work dirs on eval host
