# =============================================================================
# stage1 verl-main OpenHands training config template.
#
# Copy to <name>.env (e.g. qwen36.env), fill real values, then:
#   RLLM_CONFIG_FILE=examples/openhands_sdk/config/<name>.env \
#     bash examples/openhands_sdk/train_openhands_qwen36_npu.sh
#
# Variables NOT here (hyper-params: BATCH_SIZE / ROLLOUT_N / PPO_MINI_BATCH_SIZE
# / TP/PP/CP, profiler toggles, vLLM/Ray runtime switches) stay inline in the
# training shell script — they bind to an experiment, not a machine.
# =============================================================================

# Model & dataset
export MODEL_PATH=/path/to/Qwen3.6-35B-A3B
export OPENHANDS_DATASET=mock_npu

# Network
export PROXY_PORT=5000
export NIC_NAME=ens1fN
# export HCCL_IF_IP_OVERRIDE=10.x.y.z   # optional; auto-detected if unset

# Docker
export OPENHANDS_IMAGE=openhands-triton-env:v1

# -----------------------------------------------------------------------------
# Topology — HTTP eval worker. bind-mount is the implicit fallback when
# OPENHANDS_REMOTE_EVAL_URL is empty (see openhands_agent.py _run_remote_eval_worker).
#   RLLM_TOPOLOGY=single — worker on this host's loopback, OpenHands NPU 8-15
#   RLLM_TOPOLOGY=multi  — worker on a separate eval host
# -----------------------------------------------------------------------------
RLLM_TOPOLOGY="${RLLM_TOPOLOGY:-single}"
export EVAL_WORKER_PORT=16881
if [[ "$RLLM_TOPOLOGY" == "single" ]]; then
    export EVAL_WORKER_IP=127.0.0.1
    export OPENHANDS_CONTAINER_HOST_ALIAS=host.docker.internal
    export OPENHANDS_EVAL_DEVICE_IDS=8,9,10,11,12,13,14,15
elif [[ "$RLLM_TOPOLOGY" == "multi" ]]; then
    export EVAL_WORKER_IP=80.48.5.YY          # eval-host IP
    export TRAIN_HOST_IP=80.48.5.XX           # train-host IP (container LLM proxy reach)
    export OPENHANDS_CONTAINER_HOST_ALIAS="$TRAIN_HOST_IP"
    export OPENHANDS_EVAL_DEVICE_IDS=0,1,2,3
else
    echo "ERROR: RLLM_TOPOLOGY must be 'single' or 'multi', got '$RLLM_TOPOLOGY'" >&2
    return 1 2>/dev/null || exit 1
fi
export OPENHANDS_REMOTE_EVAL_URL="http://${EVAL_WORKER_IP}:${EVAL_WORKER_PORT}"

# Trainer-side rollout staging dir (ephemeral; never bind-mounted). Defaults to a
# gitignored package-relative dir (examples/openhands_sdk/workspace_temp). Set only
# to relocate scratch onto a bigger disk.
# export OPENHANDS_WORKSPACE_TEMP_HOST_DIR=/path/to/scratch

# Output / log
export RLLM_LOG_DIR=/workspace/results
export OPENHANDS_ARTIFACT_DIR=/workspace/results/openhands_results
export TRACE_DB_PATH=/workspace/results/rllm-openhands-traces.db
export PROFILE_SAVE_PATH=/workspace/results/profile_data/all
export OOM_SNAPSHOT_PATH=/workspace/results/profile_data

# Memory / NPU
export PYTORCH_NPU_ALLOC_CONF=max_split_size_mb:128
export ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
