# =============================================================================
# stage1 verl-main runtime config — Qwen3.6-35B-A3B × OpenHands × AscendC
# Sourced by train_openhands_qwen36_npu.sh (override file via RLLM_CONFIG_FILE).
#
# Topology switch (HTTP eval worker; bind-mount is the implicit fallback when
# OPENHANDS_REMOTE_EVAL_URL is empty):
#   RLLM_TOPOLOGY=single  (default) — eval worker on this host's loopback
#   RLLM_TOPOLOGY=multi             — eval worker on a separate host
#
# Usage:
#   bash examples/openhands_sdk/train_openhands_qwen36_npu.sh            # single
#   RLLM_TOPOLOGY=multi bash examples/openhands_sdk/train_openhands_qwen36_npu.sh
# =============================================================================

# Model & dataset
export MODEL_PATH=/home/docker/Qwen3.6-35B-A3B
export OPENHANDS_DATASET=mock_npu

# Network
export PROXY_PORT=5000
export NIC_NAME=ens1f3
# export HCCL_IF_IP_OVERRIDE=10.x.y.z   # optional; train script auto-detects if unset

# Docker
export OPENHANDS_IMAGE=openhands-triton-env:v1

# -----------------------------------------------------------------------------
# Topology — HTTP eval worker location + OpenHands NPU pool
# -----------------------------------------------------------------------------
RLLM_TOPOLOGY="${RLLM_TOPOLOGY:-single}"
export EVAL_WORKER_PORT=16881
if [[ "$RLLM_TOPOLOGY" == "single" ]]; then
    # Worker on this host's loopback (host-network dev container reaches it).
    # OpenHands containers reach the LiteLLM proxy via host.docker.internal.
    # NPU pool 8-15 keeps OpenHands disjoint from trainer's 0-7.
    export EVAL_WORKER_IP=127.0.0.1
    export OPENHANDS_CONTAINER_HOST_ALIAS=host.docker.internal
    export OPENHANDS_EVAL_DEVICE_IDS=8,9,10,11,12,13,14,15
elif [[ "$RLLM_TOPOLOGY" == "multi" ]]; then
    # Worker on a separate eval host. Fill EVAL_WORKER_IP with that host's IP.
    # OpenHands containers (on the eval host) reach the LiteLLM proxy on the
    # train host via TRAIN_HOST_IP — must be the train host, not the eval host.
    export EVAL_WORKER_IP=80.48.5.YY          # TODO: real eval-host IP
    export TRAIN_HOST_IP=80.48.5.XX           # TODO: real train-host IP
    export OPENHANDS_CONTAINER_HOST_ALIAS="$TRAIN_HOST_IP"
    export OPENHANDS_EVAL_DEVICE_IDS=0,1,2,3  # eval host's own 0-3
else
    echo "ERROR: RLLM_TOPOLOGY must be 'single' or 'multi', got '$RLLM_TOPOLOGY'" >&2
    return 1 2>/dev/null || exit 1
fi
export OPENHANDS_REMOTE_EVAL_URL="http://${EVAL_WORKER_IP}:${EVAL_WORKER_PORT}"

# Trainer-side rollout staging dir (ephemeral: the bundle is packed → POSTed to
# the remote eval worker → deleted; never bind-mounted on this side). Defaults to
# a gitignored package-relative dir (examples/openhands_sdk/workspace_temp); set
# this only to relocate the scratch onto a bigger disk.
# export OPENHANDS_WORKSPACE_TEMP_HOST_DIR=/path/to/scratch

# Output / log
export RLLM_LOG_DIR=/workspace/results
export OPENHANDS_ARTIFACT_DIR=/workspace/results/openhands_results
export TRACE_DB_PATH=/workspace/results/rllm-openhands-traces.db
export PROFILE_SAVE_PATH=/workspace/results/profile_data/all
export OOM_SNAPSHOT_PATH=/workspace/results/profile_data

# Memory / NPU
export PYTORCH_NPU_ALLOC_CONF=max_split_size_mb:128
export ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
