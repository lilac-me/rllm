# =============================================================================
# stage1 verl-main runtime config — Qwen3.6-35B-A3B × OpenHands × AscendC
# Sourced by train_openhands_qwen36_npu.sh (override file via RLLM_CONFIG_FILE).
#
# Eval worker location is set directly (no topology switch). Defaults = single-host;
# for multi-host override EVAL_WORKER_IP / OPENHANDS_EVAL_DEVICE_IDS /
# OPENHANDS_CONTAINER_HOST_ALIAS (see the "Eval worker" section below).
#
# Usage:
#   bash examples/openhands_sdk/train_openhands_qwen36_npu.sh
# =============================================================================

# Model & dataset
export MODEL_PATH=/home/docker/Qwen3.6-35B-A3B
export OPENHANDS_DATASET=mock_npu

# Network
export PROXY_PORT=5000
export NIC_NAME=ens1f3
# export HCCL_IF_IP_OVERRIDE=10.x.y.z   # optional; train script auto-detects if unset

# Docker
export OPENHANDS_IMAGE=openhands-triton-env:v1

# -----------------------------------------------------------------------------
# Eval worker location + OpenHands NPU pool — set directly (no topology switch).
# Defaults below = single-host. For multi-host, override the relevant vars.
# -----------------------------------------------------------------------------
export EVAL_WORKER_PORT=16881
# Eval worker host. Single-host: 127.0.0.1. Multi-host: the eval host's IP.
export EVAL_WORKER_IP="${EVAL_WORKER_IP:-127.0.0.1}"
export OPENHANDS_REMOTE_EVAL_URL="${OPENHANDS_REMOTE_EVAL_URL:-http://${EVAL_WORKER_IP}:${EVAL_WORKER_PORT}}"
# NPU pool for OpenHands eval containers. Single-host: 8-15 (disjoint from trainer's
# 0-7). Multi-host: the eval host's own devices, e.g. 0,1,2,3.
export OPENHANDS_EVAL_DEVICE_IDS="${OPENHANDS_EVAL_DEVICE_IDS:-8,9,10,11,12,13,14,15}"
# How the OpenHands container reaches the LiteLLM proxy (runs on the TRAIN host,
# bound to 0.0.0.0). Single-host: host.docker.internal. Multi-host: the TRAIN host's
# IP (container is on a different machine than the proxy). Consumed by openhands_agent.py:_to_container_url.
export OPENHANDS_CONTAINER_HOST_ALIAS="${OPENHANDS_CONTAINER_HOST_ALIAS:-host.docker.internal}"

# Trainer-side rollout staging dir (ephemeral: the bundle is packed → POSTed to
# the remote eval worker → deleted; never bind-mounted on this side). Defaults to
# a gitignored package-relative dir (examples/openhands_sdk/workspace_temp); set
# this only to relocate the scratch onto a bigger disk.
# export OPENHANDS_WORKSPACE_TEMP_HOST_DIR=/path/to/scratch

# Output / log
export RLLM_LOG_DIR=/workspace/results
export OPENHANDS_ARTIFACT_DIR=/workspace/results/openhands_results
export TRACE_DB_PATH=/workspace/results/rllm-openhands-traces.db
export PROFILE_SAVE_PATH=/workspace/results/profile_data/all
export OOM_SNAPSHOT_PATH=/workspace/results/profile_data

# Memory / NPU
export PYTORCH_NPU_ALLOC_CONF=max_split_size_mb:128
export ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
