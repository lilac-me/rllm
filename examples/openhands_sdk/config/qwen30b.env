# =============================================================================
# pqy real-runtime configuration  —  Qwen3-Coder-30B-A3B × OpenHands × Triton
# Sourced by debug_oom.sh (override via RLLM_CONFIG_FILE).
# Captured 2026-05-28 from pqy/debug_oom@fbd7dbe3 + runtime overrides.
#
# Topology switch:
#   RLLM_TOPOLOGY=multi   (default) — trainer host 65, eval worker host 51
#   RLLM_TOPOLOGY=single             — trainer + worker both on this host
#                                      (host-network dev container, worker on
#                                      host loopback, NPU pool split 0-7/8-15)
#
# Usage:
#   # multi-host (default)
#   bash examples/openhands_sdk/debug_oom.sh
#
#   # single-host
#   RLLM_TOPOLOGY=single bash examples/openhands_sdk/debug_oom.sh
# =============================================================================

# Model & dataset
export MODEL_PATH=/home/docker/Qwen3-Coder-30B-A3B-Instruct
export OPENHANDS_KERNELBENCH_PARQUET=/workspace/rllm-openhands/examples/openhands_sdk/kernelbench_openhands.parquet

# Common across topologies
export PROXY_PORT=5000
export EVAL_WORKER_PORT=16881
export NIC_NAME=ens1f3
export ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7   # trainer always uses 0-7

# -----------------------------------------------------------------------------
# Topology-specific
# -----------------------------------------------------------------------------
RLLM_TOPOLOGY="${RLLM_TOPOLOGY:-multi}"

if [[ "$RLLM_TOPOLOGY" == "single" ]]; then
    # Trainer in dev container (host-network mode) + worker on host loopback.
    # OpenHands containers reach the LiteLLM proxy on the host via
    # host.docker.internal (--add-host host-gateway in openhands_agent.py:787).
    # OpenHands NPU pool = 8-15 to stay disjoint from trainer's 0-7.
    export TRAIN_HOST_IP=127.0.0.1
    export EVAL_WORKER_IP=127.0.0.1
    export OPENHANDS_CONTAINER_HOST_ALIAS=host.docker.internal
    export OPENHANDS_EVAL_DEVICE_IDS=8,9,10,11,12,13,14,15
elif [[ "$RLLM_TOPOLOGY" == "multi" ]]; then
    # Trainer on 65, eval worker on 51. OpenHands containers (running on 51)
    # reach the LiteLLM proxy on 65 via the train host's real IP.
    # OpenHands NPU pool = 0-3 on the eval host (eval host has its own 0-7).
    export TRAIN_HOST_IP=80.48.5.65
    export EVAL_WORKER_IP=80.48.5.51
    export OPENHANDS_CONTAINER_HOST_ALIAS="$TRAIN_HOST_IP"
    export OPENHANDS_EVAL_DEVICE_IDS=0,1,2,3
else
    echo "ERROR: RLLM_TOPOLOGY must be 'single' or 'multi', got '$RLLM_TOPOLOGY'" >&2
    return 1 2>/dev/null || exit 1
fi

export OPENHANDS_REMOTE_EVAL_URL="http://${EVAL_WORKER_IP}:${EVAL_WORKER_PORT}"

# Docker
export OPENHANDS_IMAGE=openhands-triton-env:v1

# Output / log
export RLLM_LOG_DIR=/workspace/results
export TRACE_DB_PATH=/workspace/results/rllm-openhands-traces.db
export OPENHANDS_ARTIFACT_DIR=/workspace/results/openhands_results
export PROFILE_SAVE_PATH=/workspace/results/profile_data/all

# Memory / runtime tuning — 2048 is the confirmed BS=3 OOM fix (was 128 in pqy)
export PYTORCH_NPU_ALLOC_CONF="max_split_size_mb:2048"
export HCCL_BUFFSIZE=64
