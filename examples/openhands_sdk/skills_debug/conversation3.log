    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    @triton.jit
    def softmax_kernel(input_ptr, output_ptr, n_cols, BLOCK_SIZE: tl.constexpr):
        # Get the row index
        row_idx = tl.program_id(0)
        
        # Calculate the starting position for this row
        input_row_ptr = input_ptr + row_idx * n_cols
        output_row_ptr = output_ptr + row_idx * n_cols
        
        # Load data for this row
        offsets = tl.arange(0, BLOCK_SIZE)
        mask = offsets < n_cols
        
        # Load input data
        input_data = tl.load(input_row_ptr + offsets, mask=mask, 
other=-float('inf'))
        
        # Step 1: Find the maximum value for numerical stability
        max_val = tl.max(input_data, axis=0)
        
        # Step 2: Subtract max from each element to prevent overflow
        input_data = input_data - max_val
        
        # Step 3: Compute exponential
        exp_data = tl.math.exp2(input_data)
        
        # Step 4: Compute sum of exponentials
        sum_exp = tl.sum(exp_data, axis=0)
        
        # Step 5: Divide by sum to get softmax
        output_data = exp_data / sum_exp
        
        # Store result
        tl.store(output_row_ptr + offsets, output_data, mask=mask)
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x):
            # Create output tensor
            output = torch.empty_like(x)
            
            # Get dimensions
            n_rows, n_cols = x.shape
            
            # Define block size
            BLOCK_SIZE = triton.next_power_of_2(n_cols)
            
            # Launch kernel
            grid = (n_rows,)
            softmax_kernel[grid](x, output, n_cols, BLOCK_SIZE=BLOCK_SIZE)
            
            return output

