    import torch, torch.nn as nn
    import triton, triton.language as tl
    
    @triton.jit
    def _softmax_kernel(x_ptr, y_ptr, n_rows, n_cols, BLOCK: tl.constexpr):
        row = tl.program_id(0)
        if row >= n_rows:
            return
        cols = tl.arange(0, BLOCK)
        mask = cols < n_cols
        off = row * n_cols + cols
        x = tl.load(x_ptr + off, mask=mask, other=-float('inf'))
        x = x - tl.max(x, axis=0)
        e = tl.exp(x)
        y = e / tl.sum(e, axis=0)
        tl.store(y_ptr + off, y, mask=mask)
    
    class ModelNew(nn.Module):
        def forward(self, x):
            x = x.contiguous()
            n_rows, n_cols = x.shape
            y = torch.empty_like(x)
            BLOCK = triton.next_power_of_2(n_cols)
            _softmax_kernel[(n_rows,)](x, y, n_rows, n_cols, BLOCK=BLOCK)
            return y

