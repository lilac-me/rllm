---------------------------------------------------------------------------
   266  
   267  def validate(code, filepath="<unknown>"):
   268      """对生成代码执行完整的退化检查。
   269  
   270      返回结构化结果 dict。
   271      """
   272      result = {
   273          "valid": False,
   274          "filepath": filepath,
   275          "checks": {
   276              "triton_kernel_exists": {"passed": False, "kernels": [], 
"error": None},
   277              "kernel_called_from_forward": {"passed": False, "called": 
[], "error": None},
   278              "no_forbidden_torch_ops": {"passed": False, "violations": 
[], "error": None},
   279          },
   280          "regression_type": None,
   281          "suggestion": "",
   282      }
   283  
   284      # --- 解析 ---
   285      try:
   286          tree = ast.parse(code)
   287      except SyntaxError as e:
   288          result["checks"]["triton_kernel_exists"]["error"] = 
f"SyntaxError: {e}"
   289          result["regression_type"] = 1
   290          result["suggestion"] = "代码存在语法错误，无法解析。"
   291          return result
   292  
   293      # --- Check 1: kernel 存在性 ---
   294      kernels = find_triton_kernels(tree)
   295      kernel_names = set(kernels.keys())
   296      result["checks"]["triton_kernel_exists"]["kernels"] = [
   297          {"name": k, "line": v["line"], "has_tl_usage": 
v["has_tl_usage"]}
   298          for k, v in kernels.items()
   299      ]
   300  
   301      if not kernel_names:
   302          result["checks"]["triton_kernel_exists"]["error"] = "未找到任何 
@triton.jit 装饰的 kernel 函数"
   303          result["regression_type"] = 1
   304          result["suggestion"] = (
   305              "代码中没有 Triton kernel。必须创建至少一个 @triton.jit 
装饰的函数，"
   306              "在其中使用 tl.load/tl.store 实现核心计算逻辑。"
   307          )
   308          return result
   309  
   310      # 检查 kernel 是否使用了 tl API
   311      kernels_without_tl = [k for k, v in kernels.items() if not 
v["has_tl_usage"]]
   312      if len(kernels_without_tl) == len(kernels):
   313          result["checks"]["triton_kernel_exists"]["error"] = (
   314              f"kernel 函数 {kernels_without_tl} 未使用任何 tl.* API，"
   315              "可能是空壳 kernel"
   316          )
   317          result["regression_type"] = 1
   318          result["suggestion"] = (
   319              "虽然存在 @triton.jit 装饰的函数，但没有使用 triton.language
(tl) API。"
   320              "kernel 必须使用 tl.load/tl.store 
等进行显式内存操作和计算。"
   321          )
   322          return result
   323  
   324      result["checks"]["triton_kernel_exists"]["passed"] = True
   325  
   326      # --- Check 2: forward 是否调用 kernel ---
   327      forward_node = find_model_new_forward(tree)
   328      if forward_node is None:
   329          result["checks"]["kernel_called_from_forward"]["error"] = (
   330              "未找到 ModelNew.forward() 方法"
   331          )
   332          result["regression_type"] = 2
   333          result["suggestion"] = "代码缺少 ModelNew 类或 forward 方法。"
   334          return result
   335  
   336      wrapper_names = find_wrapper_functions(tree, kernel_names)
   337      called = check_kernel_calls_in_forward(forward_node, kernel_names, 
wrapper_names)
   338      result["checks"]["kernel_called_from_forward"]["called"] = 
list(called)
   339  
   340      if not called:
   341          result["checks"]["kernel_called_from_forward"]["error"] = (
   342              f"@triton.jit kernel {list(kernel_names)} 已定义但 forward()
未调用任何 kernel"
   343          )
   344          result["regression_type"] = 2
   345          result["suggestion"] = (
   346              f"已定义 kernel {list(kernel_names)} 但 ModelNew.forward() 
中未调用。"
   347              "forward() 必须通过 kernel_name[grid](...) 形式启动 
kernel。"
   348              f"{'也存在 wrapper 函数 ' + str(list(wrapper_names)) + ' 但 
forward 也未调用它们。' if wrapper_names else ''}"
   349          )
   350          return result
   351  
   352      result["checks"]["kernel_called_from_forward"]["passed"] = True
   353  
   354      # --- Check 3: 禁止的 torch 操作 ---
   355      violations = check_forbidden_torch_ops(forward_node)
   356      result["checks"]["no_forbidden_torch_ops"]["violations"] = 
violations
   357  
   358      if violations:
   359          result["checks"]["no_forbidden_torch_ops"]["error"] = (
   360              f"forward() 中发现 {len(violations)} 处禁止的 PyTorch 
计算操作"
   361          )
   362          violation_details = "; ".join(
   363              f"第{v['line']}行 {v['call']}" for v in violations[:5]
   364          )
   365          result["regression_type"] = 3
   366          result["suggestion"] = (
   367              f"forward() 调用了 Triton kernel 但仍使用 PyTorch 
进行部分计算: "
   368              f"{violation_details}。"
   369              "所有核心计算必须在 @triton.jit kernel 中完成，"
   370              "forward() 中只允许 buffer 分配（torch.empty 
等）和形状操作（.view/.reshape 等）。"
   371          )
   372          return result
   373  
   374      result["checks"]["no_forbidden_torch_ops"]["passed"] = True
   375  
   376      # --- 全部通过 ---
   377      result["valid"] = True
   378      return result
