     1  #!/usr/bin/env python3
     2  """Triton 实现退化检测脚本 — 通过 AST 静态分析检查生成代码是否退化为 
PyTorch 原生实现。
     3  
     4  检测三种退化类型：
     5    Type 1: 无 @triton.jit kernel，全部使用 PyTorch
     6    Type 2: 有 @triton.jit kernel 定义但 forward() 未调用
     7    Type 3: forward() 调用了 kernel 但仍有部分计算使用 torch 接口
     8  
     9  用法:
    10      python validate_triton_impl.py <file_path> [--json]
    11  
    12  退出码: 0 = 通过, 1 = 检测到退化
    13  """
    14  import ast
    15  import argparse
    16  import json
    17  import sys
    18  
    19  
    20  # 
---------------------------------------------------------------------------
    21  # 白名单：forward() 中允许的 torch 调用和 tensor 方法
    22  # 
---------------------------------------------------------------------------
    23  
    24  ALLOWED_TORCH_FUNCS = {
    25      # buffer 分配
    26      "empty", "empty_like", "empty_strided",
    27      "zeros", "zeros_like",
    28      "ones", "ones_like",
    29      "full", "full_like",
    30      # tensor 创建（有时需要用于标量常量 / 索引）
    31      "tensor", "arange", "linspace",
    32      # 类型 / 设备
    33      "as_tensor",
    34  }
    35  
    36  ALLOWED_TENSOR_METHODS = {
    37      # 形状 / 元信息
    38      "size", "shape", "stride", "numel", "dtype", "device", "dim",
    39      "is_contiguous", "data_ptr", "element_size", "storage_offset",
    40      # 布局操作（不执行计算）
    41      "contiguous", "to", "view", "view_as", "reshape",
    42      "permute", "transpose", "expand", "expand_as",
    43      "flatten", "unflatten", "unsqueeze", "squeeze",
    44      "narrow", "clone", "detach", "t",
    45      "type", "float", "half", "bfloat16", "int", "long", "bool", 
"double",
    46      "cpu", "npu", "cuda",
    47      "item", "tolist",
    48      # 原地标记
    49      "requires_grad_", "zero_",
    50      # 切片相关（一般通过 __getitem__ 而非方法，但以防万一）
    51      "index_select",
    52  }
    53  
    54  ALLOWED_TRITON_ATTRS = {
    55      "cdiv", "next_power_of_2",
    56  }
    57  
    58  FORBIDDEN_TENSOR_METHODS = {
    59      # 计算操作
    60      "sum", "mean", "max", "min", "softmax", "log_softmax",
    61      "matmul", "mm", "bmm", "addmm", "add", "sub", "mul", "div",
    62      "relu", "sigmoid", "tanh", "gelu", "silu", "elu", "leaky_relu",
    63      "exp", "log", "log2", "log10", "sqrt", "pow", "abs",
    64      "norm", "layer_norm", "batch_norm", "group_norm",
    65      "conv1d", "conv2d", "conv3d", "conv_transpose2d", "linear",
    66      "dropout", "softplus", "hardtanh", "hardswish",
    67  }
