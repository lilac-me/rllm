---------------------------------------------------------------------------
    71  # AST 辅助函数
    72  # 
---------------------------------------------------------------------------
    73  
    74  def _decorator_is_triton_jit(decorator):
    75      """判断装饰器节点是否为 triton.jit 或 @jit（从 triton 导入）。"""
    76      # @triton.jit
    77      if isinstance(decorator, ast.Attribute):
    78          if (isinstance(decorator.value, ast.Name)
    79                  and decorator.value.id == "triton"
    80                  and decorator.attr == "jit"):
    81              return True
    82      # @jit（直接导入）
    83      if isinstance(decorator, ast.Name) and decorator.id == "jit":
    84          return True
    85      # @triton.jit 作为 Call（如 @triton.jit 带参数，虽然少见）
    86      if isinstance(decorator, ast.Call):
    87          return _decorator_is_triton_jit(decorator.func)
    88      return False
    89  
    90  
    91  def _decorator_is_triton_autotune(decorator):
    92      """判断装饰器是否为 triton.autotune。"""
    93      if isinstance(decorator, ast.Attribute):
    94          if (isinstance(decorator.value, ast.Name)
    95                  and decorator.value.id == "triton"
    96                  and decorator.attr == "autotune"):
    97              return True
    98      if isinstance(decorator, ast.Call):
    99          return _decorator_is_triton_autotune(decorator.func)
   100      return False
   101  
   102  
   103  def _has_triton_decorator(func_node):
   104      """检查函数是否有 @triton.jit（可能与 @triton.autotune 组合）。"""
   105      for dec in func_node.decorator_list:
   106          if _decorator_is_triton_jit(dec):
   107              return True
   108      return False
   109  
   110  
   111  def _resolve_call_name(node):
   112      """尝试从 ast.Call 节点提取被调用函数的名称字符串。
   113  
   114      返回 (qualifier, attr) 或 (None, name) 或 None。
   115      例如：torch.empty -> ('torch', 'empty')
   116            my_func    -> (None, 'my_func')
   117            self.conv  -> ('self', 'conv')
   118            kernel[g]  -> 返回 None（kernel launch 通过 Subscript）
   119      """
   120      func = node.func if isinstance(node, ast.Call) else node
   121      if isinstance(func, ast.Attribute):
   122          if isinstance(func.value, ast.Name):
   123              return (func.value.id, func.attr)
   124          # 处理 torch.nn.functional.relu 形式
   125          if isinstance(func.value, ast.Attribute):
   126              inner = func.value
   127              if isinstance(inner.value, ast.Name):
   128                  return (f"{inner.value.id}.{inner.attr}", func.attr)
   129      if isinstance(func, ast.Name):
   130          return (None, func.id)
   131      return None
   132  
   133  
   134  def _get_subscript_value_name(node):
   135      """从 kernel[grid](...) 的 Subscript 节点提取 kernel 名称。"""
   136      if isinstance(node, ast.Subscript):
   137          if isinstance(node.value, ast.Name):
   138              return node.value.id
   139          if isinstance(node.value, ast.Attribute):
   140              if isinstance(node.value.value, ast.Name):
   141                  return f"{node.value.value.id}.{node.value.attr}"
   142      return None
   143  
   144  
   145  # 
---------------------------------------------------------------------------
   146  # 核心检查
   147  # 
---------------------------------------------------------------------------
   148  
   149  def find_triton_kernels(tree):
   150      """查找所有 @triton.jit 装饰的函数名，及其是否使用了 tl.* API。"""
   151      kernels = {}  # name -> {"has_tl_usage": bool, "line": int}
   152      for node in ast.walk(tree):
   153          if isinstance(node, ast.FunctionDef) and 
_has_triton_decorator(node):
   154              # 检查函数体中是否使用 tl.* API
   155              has_tl = False
   156              for child in ast.walk(node):
   157                  if isinstance(child, ast.Attribute):
   158                      if isinstance(child.value, ast.Name) and 
child.value.id == "tl":
   159                          has_tl = True
   160                          break
   161              kernels[node.name] = {"has_tl_usage": has_tl, "line": 
node.lineno}
   162      return kernels
   163  
   164  
   165  def find_model_new_forward(tree):
   166      """找到 ModelNew 类的 forward 方法节点。"""
   167      for node in ast.walk(tree):
   168          if isinstance(node, ast.ClassDef) and node.name == "ModelNew":
   169              for item in node.body:
   170                  if isinstance(item, (ast.FunctionDef, 
ast.AsyncFunctionDef)):
   171                      if item.name == "forward":
   172                          return item
   173      return None
   174  
   175  
   176  def find_wrapper_functions(tree, kernel_names):
   177      """找到模块级别或类级别的辅助函数，这些函数内部调用了 triton 
kernel。
   178  
   179      返回函数名集合。
   180      """
   181      wrappers = set()
   182      for node in ast.iter_child_nodes(tree):
   183          if isinstance(node, ast.FunctionDef) and node.name not in 
kernel_names:
   184              for child in ast.walk(node):
   185                  if isinstance(child, ast.Call) and 
isinstance(child.func, ast.Subscript):
   186                      name = _get_subscript_value_name(child.func)
   187                      if name in kernel_names:
   188                          wrappers.add(node.name)
   189                          break
   190                  if isinstance(child, ast.Call):
   191                      resolved = _resolve_call_name(child)
   192                      if resolved and resolved[0] is None and resolved[1] 
in kernel_names:
   193                          wrappers.add(node.name)
   194                          break
   195      return wrappers
   196  
   197  
   198  def check_kernel_calls_in_forward(forward_node, kernel_names, 
wrapper_names):
   199      """检查 forward 中是否调用了 triton kernel（直接或通过 wrapper）。
   200  
   201      返回被调用的 kernel/wrapper 名称集合。
   202      """
   203      called = set()
   204      if forward_node is None:
   205          return called
   206      for node in ast.walk(forward_node):
   207          # kernel[grid](...) 形式
   208          if isinstance(node, ast.Call) and isinstance(node.func, 
ast.Subscript):
   209              name = _get_subscript_value_name(node.func)
   210              if name in kernel_names:
   211                  called.add(name)
   212          # 直接调用 kernel_name(...) — 虽然不标准但以防万一
   213          if isinstance(node, ast.Call):
   214              resolved = _resolve_call_name(node)
   215              if resolved:
   216                  qual, attr = resolved
   217                  if qual is None and attr in kernel_names:
   218                      called.add(attr)
   219                  if qual is None and attr in wrapper_names:
   220                      called.add(attr)
   221                  # self.wrapper_name(...)
   222                  if qual == "self" and attr in wrapper_names:
   223                      called.add(attr)
   224      return called
   225  
   226  
   227  def check_forbidden_torch_ops(forward_node):
   228      """检查 forward 中是否使用了禁止的 torch 计算操作。
   229  
   230      返回违规列表 [{"line":<response clipped><NOTE>Due to the max output 
limit, only part of this file has been shown to you. You should retry this tool 
after you have searched inside the file with `grep -n` in order to find the line
numbers of what you are looking for.</NOTE>        })
   231              continue
   232  
   233          # --- triton.cdiv 等 —— 允许 ---
   234          if qual == "triton" and attr in ALLOWED_TRITON_ATTRS:
   235              continue
   236  
   237          # --- tensor 方法计算操作 ---
   238          if attr in FORBIDDEN_TENSOR_METHODS:
   239              # 排除已知安全的 qual（torch/F/triton 已在上面处理）
   240              if qual not in ("torch", "F", "triton", "functional", 
"torch.nn.functional", "nn.functional"):
   241                  violations.append({
   242                      "line": node.lineno,
   243                      "call": f"{qual}.{attr}()" if qual else f"{attr}()",
   244                      "reason": f"{attr} 是计算操作，必须在 Triton kernel 
中实现",
   245                  })
   246              continue
   247  
   248          # --- self.layer_name(x) —— 禁止 nn.Module 调用 ---
   249          if qual == "self":
   250              # 允许 self.forward() 
递归，以及属性访问不在这里（ast.Attribute 不是 Call）
   251              # self.xxx(...) 形式视为 nn.Module 前向调用
   252              if attr not in ("forward",):
   253                  violations.append({
   254                      "line": node.lineno,
   255                      "call": f"self.{attr}(...)",
   256                      "reason": f"self.{attr}() 疑似 nn.Module 
前向调用，核心计算必须在 Triton kernel 中实现",
   257                  })
   258              continue
   259  
   260      return violations
