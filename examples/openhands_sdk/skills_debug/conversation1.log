   385  def main():
   386      parser = argparse.ArgumentParser(
   387          description="检查生成代码是否退化为 PyTorch 原生实现（AST 
静态分析）"
   388      )
   389      parser.add_argument("file", help="要检查的 Python 文件路径")
   390      parser.add_argument("--json", action="store_true", help="JSON 
格式输出")
   391      args = parser.parse_args()
   392  
   393      try:
