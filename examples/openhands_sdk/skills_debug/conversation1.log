    import torch
    import triton
    import triton.language as tl
    from typing import Tuple
    
    # Kernel implementation for softmax
    @triton.jit
    def softmax_kernel(
        output_ptr,
        input_ptr,
        n_cols,
        BLOCK_SIZE: tl.constexpr,
        num_warps: tl.constexpr = 4
    ):
        # Get the row index
        row_idx = tl.program_id(0)
        
        # Calculate the starting position for this row
        input_row = input_ptr + row_idx * n_cols
        output_row = output_ptr + row_idx * n_cols
        
        # Load data into registers
        row = tl.load(input_row + tl.arange(0, BLOCK_SIZE))
        
        # Numerical stability: subtract max value
        row_max = tl.max(row, axis=0)
        row = row - row_max
        
        # Compute exp
        row = tl.exp(row)
        
        # Compute sum
        row_sum = tl.sum(row, axis=0)
        
        # Normalize
        row = row / row_sum
        
        # Store result
        tl.store(output_row + tl.arange(0, BLOCK_SIZE), row)
    
    class ModelNew(torch.nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x: torch.Tensor) -> torch.Tensor:
            # Allocate output tensor
            output = torch.empty_like(x)
            
            # Get dimensions
            n_rows, n_cols = x.shape
            
            # Define block size (should be a multiple of 32 for optimal 
performance)
