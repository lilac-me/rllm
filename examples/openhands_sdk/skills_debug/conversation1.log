   412              print(f"  - 发现 {len(kernels)} 个 @triton.jit kernel: {', 
'.join(k['name'] for k in kernels)}")
   413              print(f"  - forward() 调用: {', '.join(called)}")
   414              print("  - forward() 中无禁止的 PyTorch 计算操作")
