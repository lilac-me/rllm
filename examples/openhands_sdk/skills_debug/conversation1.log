    ):
        # Get the row index
        row_idx = tl.program_id(0)
        
        # Calculate the starting position for this row
        input_row = input_ptr + row_idx * n_cols
        output_row = output_ptr + row_idx * n_cols
        
        # Load data into registers
        row = tl.load(input_row + tl.arange(0, BLOCK_SIZE))
        
        # Numerical stability: subtract max value
        row_max = tl.max(row, axis=0)
        row = row - row_max
        
        # Compute exp
        row = tl.exp(row)
        
        # Compute sum
        row_sum = tl.sum(row, axis=0)
        
        # Normalize
        row = row / row_sum
        
        # Store result
