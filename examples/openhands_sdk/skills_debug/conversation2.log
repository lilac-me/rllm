    41  @triton.jit
    42  def add_kernel(x_ptr, y_ptr, output_ptr, n, BLOCK_SIZE: tl.constexpr):
    43      idx = tl.arange(0, BLOCK_SIZE)
    44      x = tl.load(x_ptr + idx)
    45      y = tl.load(y_ptr + idx)
    46      tl.store(output_ptr + idx, x + y)
    47  
    48  class ModelNew(nn.Module):
    49      def forward(self, x, y):
    50          output = torch.empty_like(x)
    51          add_kernel[(1,)](x, y, output, x.numel(), BLOCK_SIZE=128)
    52          return output
