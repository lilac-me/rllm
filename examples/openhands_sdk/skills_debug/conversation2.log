    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    @triton.jit
    def softmax_kernel(input_ptr, output_ptr, n_cols, BLOCK_SIZE: tl.constexpr):
        # 获取当前线程块的 ID
        pid = tl.program_id(0)
        # 计算行偏移
        row_start = pid * n_cols
        # 创建列偏移
        col_offsets = tl.arange(0, BLOCK_SIZE)
        # 计算实际偏移
        offsets = row_start + col_offsets
        
        # 加载输入数据
        mask = col_offsets < n_cols
        input = tl.load(input_ptr + offsets, mask=mask, other=-float('inf'))
        
        # 找到该行的最大值（用于数值稳定性）
        max_val = tl.max(input, axis=0)
        
        # 计算指数并减去最大值防止溢出
        exp_input = tl.exp(input - max_val)
        
        # 计算指数和
        sum_exp = tl.sum(exp_input, axis=0)
        
        # 计算 softmax 结果
        softmax_output = exp_input / sum_exp
        
        # 存储结果
        tl.store(output_ptr + offsets, softmax_output, mask=mask)
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
        
        def forward(self, x):
            # 创建输出张量
            output = torch.empty_like(x)
            
            # 获取张量维度信息
            n_rows, n_cols = x.shape
            
            # 设置块大小
            BLOCK_SIZE = triton.next_power_of_2(n_cols)
            
            # 如果列数超过 1024，则使用较小的块大小
            if BLOCK_SIZE > 1024:
                BLOCK_SIZE = 1024
                
            # 创建 grid
            grid = (n_rows,)
            
            # 启动 kernel
            softmax_kernel[grid](x, output, n_cols, BLOCK_SIZE=BLOCK_SIZE)
            
            return output

