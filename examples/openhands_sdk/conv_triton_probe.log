   111  
   112  def _decorator_is_triton_jit(decorator):
   113      """判断装饰器节点是否为 triton.jit 或 @jit（从 triton 导入）。"""
   114      # @triton.jit
   115      if isinstance(decorator, ast.Attribute):
   116          if (isinstance(decorator.value, ast.Name)
   117                  and decorator.value.id == "triton"
   118                  and decorator.attr == "jit"):
   119              return True
   120      # @jit（直接导入）
   121      if isinstance(decorator, ast.Name) and decorator.id == "jit":
   122          return True
   123      # @triton.jit 作为 Call（如 @triton.jit 带参数，虽然少见）
   124      if isinstance(decorator, ast.Call):
   125          return _decorator_is_triton_jit(decorator.func)
   126      return False
   127  
   128  
   129  def _decorator_is_triton_autotune(decorator):
   130      """判断装饰器是否为 triton.autotune。"""
   131      if isinstance(decorator, ast.Attribute):
   132          if (isinstance(decorator.value, ast.Name)
   133                  and decorator.value.id == "triton"
   134                  and decorator.attr == "autotune"):
   135              return True
   136      if isinstance(decorator, ast.Call):
   137          return _decorator_is_triton_autotune(decorator.func)
   138      return False
   139  
   140  
   141  def _has_triton_decorator(func_node):
   142      """检查函数是否有 @triton.jit（可能与 @triton.autotune 组合）。"""
   143      for dec in func_node.decorator_list:
   144          if _decorator_is_triton_jit(dec):
   145              return True
   146      return False
