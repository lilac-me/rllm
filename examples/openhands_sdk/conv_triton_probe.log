    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    
    @triton.jit
    def softmax_kernel(
        input_ptr,
        output_ptr,
        M,
        N,
        stride_im,
        stride_in,
        stride_om,
        stride_on,
        BLOCK_SIZE: tl.constexpr,
    ):
        pid = tl.program_id(0)
    
        # 当前行的列索引
        cols = tl.arange(0, BLOCK_SIZE)
        mask = cols < N
    
        # 加载当前行的数据
        row_offset = pid * stride_im
        x = tl.load(input_ptr + row_offset + cols, mask=mask, other=0.0)
    
        # 第1步：求行最大值（数值稳定性）
        max_val = tl.max(x, axis=0)
    
        # 第2步：x = x - max
        x = x - max_val
    
        # 第3步：y = exp(x)
        y = tl.math.exp(x)
    
        # 第4步：求和
        sum_val = tl.sum(y, axis=0)
    
        # 第5步：y = y / sum
        y = y / sum_val
    
        # 写回输出
        tl.store(output_ptr + row_offset + cols, y, mask=mask)
    
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x):
            M, N = x.shape
            output = torch.empty_like(x)
    
            # 确保输入是连续的
            x = x.contiguous()
    
            # 选择 BLOCK_SIZE：取 2 的幂次，不超过 N
            BLOCK_SIZE = triton.next_power_of_2(N)
            if BLOCK_SIZE > N:
                BLOCK_SIZE = 1 << (BLOCK_SIZE.bit_length() - 1)
            # 确保 BLOCK_SIZE 至少为 128（硬件友好）
            if BLOCK_SIZE < 128:
                BLOCK_SIZE = 128
    
            # grid: 每行一个 program
            grid = (M,)
    
            softmax_kernel[grid](
                x,
                output,
                M,
                N,
                x.stride(0),
                x.stride(1),
                output.stride(0),
                output.stride(1),
                BLOCK_SIZE=BLOCK_SIZE,
            )
    
            return output
    

