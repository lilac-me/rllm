   553  ### A.6 完整 GELU 示例
   554  
   555  ```python
   556  import triton
   557  import triton.language as tl
   558  import torch
   559  
   560  @triton.jit
   561  def triton_easy_kernel(in_ptr0, out_ptr0, NUMEL: tl.constexpr):
   562      idx_block = tl.arange(0, NUMEL)
   563      x = tl.load(in_ptr0 + idx_block)
   564      ret = x [3m* 0.5 *[0m (1.0 + tl.erf(x / tl.sqrt(2.0)))
   565      tl.store(out_ptr0 + idx_block, ret)
