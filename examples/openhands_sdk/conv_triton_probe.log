   400  
   401  ## 注意conv类卷积算子编写：
   402  torch 
module中的卷积算子生成会包含一个随机权重weight，为保证我们生成的triton实现也具有
相同的结果，我们可以在triton的host侧代码中生成对应的weight，例如：
   403  ```python
   404  import torch
   405  import torch.nn as nn
   406  import triton
   407  import triton.language as tl
   408  
   409  @triton.jit
   410  def triton_kernel():
   411      pass
   412  def triton_host():
   413      args = ...
   414      weight = nn.conv([3m**[0margs).weight.to(device)
   415  ```
   416  
具体的参数和''nn''中调用的module要与torch保持一致，device与传入的backend保持一致
（如"npu"），我会在调用triton之前固定相同的随机种子，所以在这里只需要正确地创建
类的实例，并导出权重
   417  
   418  ---
   419  
   420  ## 附录：完整代码示例
   421  
   422  ### A.1 Vector Add（向量加法）
   423  
   424  ```python
   425  @triton.jit
   426  def vector_add_kernel(a_ptr, b_ptr, c_ptr, n_elements, BLOCK_SIZE: 
tl.constexpr):
   427      pid = tl.program_id(0)
   428      offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
   429      mask = offsets < n_elements
   430  
   431      a = tl.load(a_ptr + offsets, mask=mask)
   432      b = tl.load(b_ptr + offsets, mask=mask)
   433      c = a + b
   434  
   435      tl.store(c_ptr + offsets, c, mask=mask)
   436  
   437  class ModelNew(torch.nn.Module):
   438      def forward(self, a, b):
   439          c = torch.empty_like(a)
   440          n_elements = a.numel()
   441          grid = (triton.cdiv(n_elements, BLOCK_SIZE),)
   442          vector_add_kernel[grid](a, b, c, n_elements, BLOCK_SIZE=1024)
   443          return c
   444  ```
   445  
   446  ### A.2 Reduce 算子（块内归约 + 原子操作）
   447  
   448  ```python
   449  @triton.jit
   450  def reduction_kernel(input_ptr, output_ptr, n_elements, BLOCK_SIZE: 
tl.constexpr):
   451      pid = tl.program_id(0)
   452      offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
   453      mask = offsets < n_elements
   454  
   455      data = tl.load(input_ptr + offsets, mask=mask, other=0.0)
   456      block_sum = tl.sum(data, axis=0)
   457      tl.atomic_add(output_ptr, block_sum)
   458  ```
   459  
   460  ### A.3 MatMul（固定核心数启动）
   461  
   462  ```python
   463  @triton.jit
   464  def matmul_kernel(
   465      a_ptr, b_ptr, c_ptr,
   466      M, N, K,
   467      num_cores: tl.constexpr,
   468      BLOCK_M: tl.constexpr,
   469      BLOCK_N: tl.constexpr,
   470      BLOCK_K: tl.constexpr,
   471  ):
   472      pid = tl.program_id(0)
   473      NUM_BLOCKS_M = triton.cdiv(M, BLOCK_M)
   474      NUM_BLOCKS_N = triton.cdiv(N, BLOCK_N)
   475      NUM_BLOCKS = NUM_BLOCKS_M * NUM_BLOCKS_N
   476  
   477      for block_idx in range(pid, NUM_BLOCKS, num_cores):
   478          block_m = block_idx // NUM_BLOCKS_N
   479          block_n = block_idx % NUM_BLOCKS_N
   480  
   481          accumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
   482  
   483          for k in range(0, K, BLOCK_K):
   484              a_offset = (block_m [3m* BLOCK_M + tl.arange(0, BLOCK_M))[:, [0m
[3mNone] *[0m K + \
   485                         (k + tl.arange(0, BLOCK_K))[None, :]
   486              a_mask = (block_m * BLOCK_M + tl.arange(0, BLOCK_M))[:, 
None] < M
   487              a = tl.load(a_ptr + a_offset, mask=a_mask, other=0.0)
   488  
   489              b_offset = (k + tl.arange(0, BLOCK_K))[:, None] * N + \
   490                         (block_n * BLOCK_N + tl.arange(0, BLOCK_N))[None,
:]
   491              b_mask = (block_n * BLOCK_N + tl.arange(0, BLOCK_N))[None, 
:] < N
   492              b = tl.load(b_ptr + b_offset, mask=b_mask, other=0.0)
   493  
   494              accumulator += tl.dot(a, b)
   495  
   496          c_offset = (block_m [3m* BLOCK_M + tl.arange(0, BLOCK_M))[:, None] [0m
[3m*[0m N + \
   497                     (block_n * BLOCK_N + tl.arange(0, BLOCK_N))[None, :]
   498          c_mask = ((block_m * BLOCK_M + tl.arange(0, BLOCK_M))[:, None] <
M) & \
   499                   ((block_n * BLOCK_N + tl.arange(0, BLOCK_N))[None, :] <
N)
   500          tl.store(c_ptr + c_offset, accumulator, mask=c_mask)
   501  
   502  class ModelNew(torch.nn.Module):
   503      def __init__(self):
   504          super().__init__()
   505  
   506      def forward(self, a, b):
   507          M, K = a.shape
   508          K2, N = b.shape
   509          assert K == K2
   510          c = torch.empty((M, N), device=a.device, dtype=a.dtype)
   511  
   512          num_cores = 20
   513          BLOCK_M, BLOCK_N, BLOCK_K = 128, 256, 256
   514  
   515          matmul_kernel[(num_cores,)](a, b, c, M, N, K, num_cores,
   516                                      BLOCK_M, BLOCK_N, BLOCK_K)
   517          return c
   518  ```
   519  
   520  ### A.4 LayerNorm 核心逻辑（归一化）
   521  
   522  ```python
   523  # 1. 计算均值
   524  mean = tl.sum(x, axis=0) / n_cols
   525  
   526  # 2. 计算方差
   527  x_centered = x - mean
   528  variance = tl.sum(x_centered * x_centered, axis=0) / n_cols
   529  
   530  # 3. 归一化
   531  variance = tl.maximum(variance, 0.0)
   532  rstd = 1.0 / tl.sqrt(variance + eps)
   533  normalized = x_centered * rstd
   534  
   535  # 4. 应用 weight 和 bias
   536  output = normalized * weight + bias
   537  ```
   538  
   539  ### A.5 Double Kernel（多内核调用）
   540  
