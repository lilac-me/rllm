   386  for col_start in range(0, n_cols, BLOCK):
   387      x = tl.load(...)  # 重复加载！
   388      sum_val = update(sum_val, x)
   389  
   390  # ✅ 正确：循环内累积，减少加载
   391  for col_start in range(0, n_cols, BLOCK):
   392      x = tl.load(...)
   393      max_val = update(max_val, x)
   394      sum_val = update(sum_val, f(x))  # 同时处理
   395  ```
