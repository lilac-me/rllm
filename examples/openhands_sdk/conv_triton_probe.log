    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    
    @triton.jit
    def softmax_kernel(
        input_ptr,
        output_ptr,
        stride_in,
        stride_out,
        n_rows,
        n_cols,
        BLOCK: tl.constexpr,
        ROWS_PER_BLOCK: tl.constexpr,
    ):
        pid = tl.program_id(0)
        num_cores = tl.num_programs(0)
    
        # Each program handles multiple row blocks via loop
        for row_block_start in range(pid [3m* ROWS_PER_BLOCK, n_rows, num_cores *[0m 
ROWS_PER_BLOCK):
            row_offs = row_block_start + tl.arange(0, ROWS_PER_BLOCK)
            row_mask = row_offs < n_rows
            col_offs = tl.arange(0, BLOCK)
            col_mask = col_offs < n_cols
            mask_2d = row_mask[:, None] & col_mask[None, :]
    
            # Single 2D load: [ROWS_PER_BLOCK, BLOCK]
            x = tl.load(
                input_ptr + row_offs[:, None] * stride_in + col_offs[None, :],
                mask=mask_2d, other=-float("inf"),
            )
    
            # Phase 1: row-wise max (shape: [ROWS_PER_BLOCK, 1])
            row_max = tl.max(x, axis=1, keep_dims=True)
    
            # Phase 2: exp(x - max) and sum
            x_shifted = x - row_max
            exp_x = tl.exp(x_shifted)
            row_sum = tl.sum(tl.where(mask_2d, exp_x, 0.0), axis=1, 
keep_dims=True)
    
            # Phase 3: normalize and store
            output = exp_x / row_sum
            tl.store(
                output_ptr + row_offs[:, None] * stride_out + col_offs[None, :],
                output,
                mask=mask_2d,
            )
    
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x):
            M, N = x.shape
            output = torch.empty_like(x)
    
            # BLOCK_SIZE >= N to eliminate inner column loop
            BLOCK = triton.next_power_of_2(N)
            # ROWS_PER_BLOCK: small enough to fit in UB with 2D tile
            # 4 rows × 1024 cols × 4B = 16KB per buffer, safe with multi-buffer
            ROWS_PER_BLOCK = 4
    
            num_blocks = triton.cdiv(M, ROWS_PER_BLOCK)
            num_cores = 48
            grid_size = min(num_blocks, num_cores)
            grid = (grid_size,)
    
            softmax_kernel[grid](
                x,
                output,
                x.stride(0),
                output.stride(0),
                M,
                N,
                BLOCK=BLOCK,
                ROWS_PER_BLOCK=ROWS_PER_BLOCK,
            )
            return output

