    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    
    @triton.jit
    def softmax_kernel(
        input_ptr,
        output_ptr,
        M,
        N,
        stride_im,
        stride_in,
        stride_om,
        stride_on,
        BLOCK_SIZE: tl.constexpr,
        ROWS_PER_BLOCK: tl.constexpr,
    ):
        pid = tl.program_id(0)
    
        # 多行索引：每个 program 处理 ROWS_PER_BLOCK 行
        row_offs = pid * ROWS_PER_BLOCK + tl.arange(0, ROWS_PER_BLOCK)
        row_mask = row_offs < M
    
        # 列索引
        col_offs = tl.arange(0, BLOCK_SIZE)
        col_mask = col_offs < N
    
        # 2D 掩码
        mask_2d = row_mask[:, None] & col_mask[None, :]
    
        # 2D 加载：[ROWS_PER_BLOCK, BLOCK_SIZE]
        x = tl.load(
            input_ptr + row_offs[:, None] * stride_im + col_offs[None, :],
            mask=mask_2d,
            other=0.0,
        )
    
        # 第1步：求每行的最大值（沿列方向 reduce，axis=1）
        row_max = tl.max(x, axis=1, keep_dims=True)
    
        # 第2步：x = x - max（广播）
        x = x - row_max
    
        # 第3步：y = exp(x)
        y = tl.math.exp(x)
    
        # 第4步：求每行的和（沿列方向 reduce，axis=1）
        row_sum = tl.sum(y, axis=1, keep_dims=True)
    
        # 第5步：y = y / sum（广播）
        y = y / row_sum
    
        # 2D 存储
        tl.store(
            output_ptr + row_offs[:, None] * stride_om + col_offs[None, :],
            y,
            mask=mask_2d,
        )
    
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x):
            M, N = x.shape
            output = torch.empty_like(x)
    
            # 确保输入是连续的
            x = x.contiguous()
    
            # 选择 BLOCK_SIZE：取 2 的幂次，不超过 N
            BLOCK_SIZE = triton.next_power_of_2(N)
            if BLOCK_SIZE > N:
                BLOCK_SIZE = 1 << (BLOCK_SIZE.bit_length() - 1)
            if BLOCK_SIZE < 128:
                BLOCK_SIZE = 128
    
            # ROWS_PER_BLOCK：每个 program 处理多行，减少 grid 大小
            # N=1024 时，推荐 ROWS_PER_BLOCK=4-8
            ROWS_PER_BLOCK = 8
    
            # 计算实际需要的 block 数
            num_blocks = triton.cdiv(M, ROWS_PER_BLOCK)
    
            # 获取物理核数，grid 取 min(num_blocks, num_cores)
            device = torch.npu.current_device()
            device_properties = 
triton.runtime.driver.active.utils.get_device_properties(device)
            num_cores = device_properties.get("num_aicore", 48)
            grid_size = min(num_blocks, num_cores)
            grid = (grid_size,)
    
            softmax_kernel[grid](
                x,
                output,
                M,
                N,
                x.stride(0),
                x.stride(1),
                output.stride(0),
                output.stride(1),
                BLOCK_SIZE=BLOCK_SIZE,
                ROWS_PER_BLOCK=ROWS_PER_BLOCK,
                multibuffer=True,
            )
    
            return output

