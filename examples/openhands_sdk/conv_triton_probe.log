    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    
    @triton.jit
    def softmax_kernel(
        input_ptr,
        output_ptr,
        M,
        N,
        stride_im,
        stride_in,
        stride_om,
        stride_on,
        BLOCK_SIZE: tl.constexpr,
    ):
        # Each program handles one row
        pid = tl.program_id(0)
    
        # Row offset
        row_offset = pid
    
        # Phase 1: Find max of the row (in fp32 for precision)
        max_val = float("-inf")
        for start in range(0, N, BLOCK_SIZE):
            offsets = start + tl.arange(0, BLOCK_SIZE)
            mask = offsets < N
            data = tl.load(input_ptr + row_offset * stride_im + offsets, 
mask=mask, other=float("-inf"))
            data_f32 = data.to(tl.float32)
            max_val = tl.maximum(max_val, tl.max(data_f32, axis=0))
    
        # Phase 2: Compute exp(x - max) and sum
        sum_val = 0.0
        for start in range(0, N, BLOCK_SIZE):
            offsets = start + tl.arange(0, BLOCK_SIZE)
            mask = offsets < N
            data = tl.load(input_ptr + row_offset * stride_im + offsets, 
mask=mask, other=0.0)
            data_f32 = data.to(tl.float32)
            exp_val = tl.math.exp(data_f32 - max_val)
            sum_val += tl.sum(exp_val, axis=0)
    
        # Phase 3: Normalize and store
        for start in range(0, N, BLOCK_SIZE):
            offsets = start + tl.arange(0, BLOCK_SIZE)
            mask = offsets < N
            data = tl.load(input_ptr + row_offset * stride_im + offsets, 
mask=mask, other=0.0)
            data_f32 = data.to(tl.float32)
            exp_val = tl.math.exp(data_f32 - max_val)
            result = exp_val / sum_val
            tl.store(output_ptr + row_offset * stride_om + offsets, 
result.to(input_ptr.dtype.element_ty), mask=mask)
    
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x):
            M, N = x.shape
            output = torch.empty_like(x)
    
            BLOCK_SIZE = triton.next_power_of_2(N)
            if BLOCK_SIZE > 2048:
                BLOCK_SIZE = 2048
    
            grid = (M,)
            softmax_kernel[grid](
                x,
                output,
                M,
                N,
                x.stride(0),
                x.stride(1),
                output.stride(0),
                output.stride(1),
                BLOCK_SIZE=BLOCK_SIZE,
            )
            return output

[1m  new_str: [0m
    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    
    @triton.jit
    def softmax_kernel(
        input_ptr,
        output_ptr,
        stride_in,
        stride_out,
        n_rows,
        n_cols,
        BLOCK: tl.constexpr,
        ROWS_PER_BLOCK: tl.constexpr,
    ):
        pid = tl.program_id(0)
        row_offs = pid * ROWS_PER_BLOCK + tl.arange(0, ROWS_PER_BLOCK)
        row_mask = row_offs < n_rows
        col_offs = tl.arange(0, BLOCK)
        col_mask = col_offs < n_cols
        mask_2d = row_mask[:, None] & col_mask[None, :]
    
        # Single 2D load: [ROWS_PER_BLOCK, BLOCK]
        x = tl.load(
            input_ptr + row_offs[:, None] * stride_in + col_offs[None, :],
            mask=mask_2d, other=-float("inf"),
        )
    
        # Phase 1: row-wise max (shape: [ROWS_PER_BLOCK, 1])
        row_max = tl.max(x, axis=1, keep_dims=True)
    
        # Phase 2: exp(x - max) and sum
        x_shifted = x - row_max
        exp_x = tl.exp(x_shifted)
        row_sum = tl.sum(tl.where(mask_2d, exp_x, 0.0), axis=1, keep_dims=True)
    
        # Phase 3: normalize and store
        output = exp_x / row_sum
        tl.store(
            output_ptr + row_offs[:, None] * stride_out + col_offs[None, :],
            output,
            mask=mask_2d,
        )
    
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x):
            M, N = x.shape
            output = torch.empty_like(x)
    
            # BLOCK_SIZE >= N to eliminate inner loop
            BLOCK = triton.next_power_of_2(N)
            # ROWS_PER_BLOCK: balance between grid size and per-core work
            # For N=1024, use 8 rows per block → grid = M/8
            ROWS_PER_BLOCK = 8
    
            num_blocks = triton.cdiv(M, ROWS_PER_BLOCK)
            num_cores = 48
            grid_size = min(num_blocks, num_cores)
            grid = (grid_size,)
    
            softmax_kernel[grid](
                x,
                output,
                x.stride(0),
                output.stride(0),
                M,
                N,
                BLOCK=BLOCK,
                ROWS_PER_BLOCK=ROWS_PER_BLOCK,
            )
            return output

