    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    
    @triton.jit
    def softmax_kernel(
        input_ptr,
        output_ptr,
        M,
        N,
        stride_im,
        stride_in,
        BLOCK_SIZE: tl.constexpr,
    ):
        # Each program handles one row
        pid = tl.program_id(0)
    
        # Row offset
        row_offset = pid
    
        # Column indices
        cols = tl.arange(0, BLOCK_SIZE)
        mask = cols < N
    
        # Load the row
        offsets = row_offset [3m* stride_im + cols *[0m stride_in
        x = tl.load(input_ptr + offsets, mask=mask, other=0.0)
    
        # Convert to float32 for numerical stability in reduction
        x_f32 = x.to(tl.float32)
    
        # Stage 1: max
        max_val = tl.max(x_f32, axis=0)
    
        # Stage 2: subtract max and exp
        x_shifted = x_f32 - max_val
        exp_x = tl.math.exp(x_shifted)
    
        # Stage 3: sum
        sum_val = tl.sum(exp_x, axis=0)
    
        # Stage 4: divide
        y = exp_x / sum_val
    
        # Convert back to original dtype
        y_out = y.to(input_ptr.dtype.element_ty)
    
        # Store
        tl.store(output_ptr + offsets, y_out, mask=mask)
    
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x):
            M, N = x.shape
            output = torch.empty_like(x)
    
            # Get number of cores for grid
            num_cores = 32
    
            # BLOCK_SIZE: power of 2, should divide N well
            # For N=1024, use 1024 so each row is loaded in one chunk
            BLOCK_SIZE = 1024
    
            # Grid: one program per row, capped by num_cores
            grid_size = min(M, num_cores)
    
            softmax_kernel[grid_size](
                x,
                output,
                M,
                N,
                x.stride(0),
                x.stride(1),
                BLOCK_SIZE=BLOCK_SIZE,
            )
    
            return output
    

