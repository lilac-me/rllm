    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    
    @triton.jit
    def softmax_kernel(
        input_ptr,
        output_ptr,
        M,
        N,
        stride_im,
        stride_in,
        stride_om,
        stride_on,
        BLOCK_SIZE: tl.constexpr,
        ROWS_PER_BLOCK: tl.constexpr,
    ):
        pid = tl.program_id(0)
    
        # 每个 program 处理 ROWS_PER_BLOCK 行（通过循环串行处理）
        for row_idx in range(ROWS_PER_BLOCK):
            current_row = pid * ROWS_PER_BLOCK + row_idx
            row_mask = current_row < M
    
            # 列索引
            cols = tl.arange(0, BLOCK_SIZE)
            col_mask = cols < N
    
            # 加载当前行的数据
            row_offset = current_row * stride_im
            x = tl.load(input_ptr + row_offset + cols, mask=col_mask, other=0.0)
    
            # 第1步：求行最大值（数值稳定性）
            max_val = tl.max(x, axis=0)
    
            # 第2步：x = x - max
            x = x - max_val
    
            # 第3步：y = exp(x)
            y = tl.exp(x)
    
            # 第4步：求和
            sum_val = tl.sum(y, axis=0)
    
            # 第5步：y = y / sum
            y = y / sum_val
    
            # 写回输出
            tl.store(output_ptr + row_offset + cols, y, mask=col_mask)
    
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x):
            M, N = x.shape
            output = torch.empty_like(x)
    
            # 确保输入是连续的
            x = x.contiguous()
    
            # 选择 BLOCK_SIZE：取 2 的幂次，不超过 N
            BLOCK_SIZE = triton.next_power_of_2(N)
            if BLOCK_SIZE > N:
                BLOCK_SIZE = 1 << (BLOCK_SIZE.bit_length() - 1)
            if BLOCK_SIZE < 128:
                BLOCK_SIZE = 128
    
            # ROWS_PER_BLOCK：每个 program 处理多行，减少 grid 大小
            # N=1024 时，推荐 ROWS_PER_BLOCK=4-8
            ROWS_PER_BLOCK = 8
    
            # 计算实际需要的 block 数
            num_blocks = triton.cdiv(M, ROWS_PER_BLOCK)
    
            # 获取物理核数，grid 取 min(num_blocks, num_cores)
            device = torch.npu.current_device()
            device_properties = 
triton.runtime.driver.active.utils.get_device_properties(device)
            num_cores = device_properties.get("num_aicore", 48)
            grid_size = min(num_blocks, num_cores)
            grid = (grid_size,)
    
            softmax_kernel[grid](
                x,
                output,
                M,
                N,
                x.stride(0),
                x.stride(1),
                output.stride(0),
                output.stride(1),
                BLOCK_SIZE=BLOCK_SIZE,
                ROWS_PER_BLOCK=ROWS_PER_BLOCK,
                multibuffer=True,
            )
    
            return output

