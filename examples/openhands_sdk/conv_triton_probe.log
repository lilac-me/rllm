   149  def _resolve_call_name(node):
   150      """尝试从 ast.Call 节点提取被调用函数的名称字符串。
   151  
   152      返回 (qualifier, attr) 或 (None, name) 或 None。
   153      例如：torch.empty -> ('torch', 'empty')
   154            my_func    -> (None, 'my_func')
   155            self.conv  -> ('self', 'conv')
   156            kernel[g]  -> 返回 None（kernel launch 通过 Subscript）
   157      """
   158      func = node.func if isinstance(node, ast.Call) else node
   159      if isinstance(func, ast.Attribute):
   160          if isinstance(func.value, ast.Name):
   161              return (func.value.id, func.attr)
   162          # 处理 torch.nn.functional.relu 形式
   163          if isinstance(func.value, ast.Attribute):
   164              inner = func.value
   165              if isinstance(inner.value, ast.Name):
   166                  return (f"{inner.value.id}.{inner.attr}", func.attr)
   167      if isinstance(func, ast.Name):
   168          return (None, func.id)
   169      return None
   170  
