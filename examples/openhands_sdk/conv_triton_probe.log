   390  def _load_code(path, want_json):
   391      """读取代码文件；失败时返回 None，由调用方决定退出。"""
   392      try:
   393          with open(path, "r", encoding="utf-8") as f:
   394              return f.read()
   395      except FileNotFoundError:
   396          if want_json:
   397              logger.info("%s", json.dumps({"valid": False, "error": 
f"文件不存在: {path}"}))
   398          else:
   399              logger.error("[ERROR] 文件不存在: %s", path)
   400          return None
