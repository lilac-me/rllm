   356  def validate(code, filepath="<unknown>"):
   357      """对生成代码执行完整的退化检查。
   358  
   359      返回结构化结果 dict。
   360      """
   361      result = _empty_result(filepath)
   362  
   363      try:
   364          tree = ast.parse(code)
   365      except SyntaxError as e:
   366          result["checks"]["triton_kernel_exists"]["error"] = 
f"SyntaxError: {e}"
   367          result["regression_type"] = 1
   368          result["suggestion"] = "代码存在语法错误，无法解析。"
   369          return result
   370  
   371      ok, kernel_names = _check_kernel_exists(result, tree)
   372      if not ok:
   373          return result
   374  
   375      ok, forward_node = _check_forward_calls_kernel(result, tree, 
kernel_names)
   376      if not ok:
   377          return result
   378  
   379      if not _check_no_forbidden_ops(result, forward_node):
   380          return result
   381  
   382      result["valid"] = True
   383      return result
