     7  ## 1. 编程基础
     8  
     9  ### 1.1 核心概念
    10  
    11  Triton Ascend 采用与 Triton GPU 类似的执行模型：
    12  
    13  - [1;3m**[0m[1mKernel（内核）[0m[1;3m**[0m：用 `@triton.jit` 装饰的函数，在 NPU 上并行执行
    14  - [1;3m**[0m[1mGrid（网格）[0m[1;3m**[0m：启动的并行程序总数，由 `kernel[grid](args)` 指定
    15  - [1;3m**[0m[1mBlock（块）[0m[1;3m**[0m：每个程序处理的数据块，由 `tl.program_id(0)` 区分
    16  
    17  #### 内存层次
    18  - [1;3m**[0m[1m全局内存[0m[1;3m**[0m: 主内存，所有程序可访问，延迟高
    19  - [1;3m**[0m[1m共享内存[0m[1;3m**[0m: 块内共享，延迟低，容量有限
    20  - [1;3m**[0m[1m寄存器[0m[1;3m**[0m: 每个线程私有，最快访问
    21  
    22  ### 1.2 标准 Kernel 结构（五步模式）
    23  
    24  ```python
    25  @triton.jit
    26  def triton_better_kernel(in_ptr0, out_ptr0, xnumel, XBLOCK: 
tl.constexpr, XBLOCK_SUB: tl.constexpr):
    27      # Step 1: 计算当前核的起始偏移（核间切分）
    28      xoffset = tl.program_id(0) * XBLOCK
    29  
    30      # Step 2: 核内循环（核内切分）
    31      for xoffset_sub in range(0, XBLOCK, XBLOCK_SUB):
    32          # Step 3: 构造数据索引
    33          x_index = xoffset + xoffset_sub + tl.arange(0, XBLOCK_SUB)[:]
    34  
    35          # Step 4: 边界处理（mask）
    36          xmask = x_index < xnumel
    37  
    38          # Step 5: 加载 → 计算 → 存储
    39          x = tl.load(in_ptr0 + x_index, xmask)
    40          ret = x [3m* 0.5 *[0m (1.0 + tl.erf(x / tl.sqrt(2.0)))
    41          tl.store(out_ptr0 + x_index, ret, xmask)
    42  ```
    43  
    44  ### 1.3 内核启动方式
    45  ```python
    46  def launch_kernel(input_tensor, output_tensor):
    47      BLOCK_SIZE = 1024  
    48      grid = (triton.cdiv(input_tensor.numel(), BLOCK_SIZE),)
    49      
    50      kernel[grid](
    51          output_tensor, input_tensor, input_tensor.numel(),
    52          BLOCK_SIZE=BLOCK_SIZE,
    53      )
    54  ```
    55  
    56  ### 1.4 边界处理（Mask）
    57  
    58  使用 mask 防止越界访问，确保只处理合法范围内的数据：
    59  
    60  ```python
    61  xmask = x_index < xnumel
    62  x = tl.load(in_ptr0 + x_index, mask=xmask, other=0.0)
    63  tl.store(out_ptr0 + x_index, ret, mask=xmask)
    64  ```
    65  
    66  ### 1.5 编程模式
    67  
    68  #### 1.5.1 向量操作模式
    69  适用于元素级运算：加法、乘法、激活函数等。
    70  
    71  ```python
    72  @triton.jit
    73  def vector_add_kernel(a_ptr, b_ptr, c_ptr, n_elements, BLOCK_SIZE: 
tl.constexpr):
    74      pid = tl.program_id(0)
    75      offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
    76      mask = offsets < n_elements
    77      
    78      a = tl.load(a_ptr + offsets, mask=mask)
    79      b = tl.load(b_ptr + offsets, mask=mask)
    80      c = a + b
    81      
    82      tl.store(c_ptr + offsets, c, mask=mask)
    83  ```
    84  
    85  #### 1.5.2 归约模式
    86  适用于求和、最大值、最小值等聚合操作。
    87  
    88  ```python
    89  @triton.jit
    90  def reduction_kernel(input_ptr, output_ptr, n_elements, BLOCK_SIZE: 
tl.constexpr):
    91      pid = tl.program_id(0)
    92      offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
    93      mask = offsets < n_elements
    94      
    95      # 加载数据
    96      data = tl.load(input_ptr + offsets, mask=mask, other=0.0)
    97      
    98      # 块内归约
    99      block_sum = tl.sum(data, axis=0)
   100      
   101      # 原子操作写回全局内存
   102      if pid == 0:  # 只有第一个块写入结果
   103          tl.atomic_add(output_ptr, block_sum)
   104  ```
   105  
   106  #### 1.5.3 矩阵乘法模式
   107  使用块指针高效处理 2D 数据。
   108  
   109  ```python
   110  @triton.jit
   111  def matmul_kernel(a_ptr, b_ptr, c_ptr, M, N, K, stride_am, stride_ak, 
stride_bk, stride_bn, stride_cm, stride_cn, BLOCK_SIZE_M: tl.constexpr, 
BLOCK_SIZE_N: tl.constexpr, BLOCK_SIZE_K: tl.constexpr):
   112      # 获取程序 ID
   113      pid_m = tl.program_id(0)
   114      pid_n = tl.program_id(1)
   115      
   116      # 初始化累加器
   117      accumulator = tl.zeros((BLOCK_SIZE_M, BLOCK_SIZE_N), 
dtype=tl.float32)
   118      
   119      # 主循环：沿 K 轴迭代
   120      for k in range(0, K, BLOCK_SIZE_K):
   121          # 创建块指针
   122          a_block_ptr = tl.make_block_ptr(
   123              base=a_ptr, shape=(M, K), strides=(stride_am, stride_ak),
   124              offsets=(pid_m * BLOCK_SIZE_M, k), 
   125              block_shape=(BLOCK_SIZE_M, BLOCK_SIZE_K), order=(1, 0)
   126          )
   127          b_block_ptr = tl.make_block_ptr(
   128              base=b_ptr, shape=(K, N), strides=(stride_bk, stride_bn),
   129              offsets=(k, pid_n * BLOCK_SIZE_N), 
   130              block_shape=(BLOCK_SIZE_K, BLOCK_SIZE_N), order=(1, 0)
   131          )
   132          
   133          # 加载数据块
   134          a = tl.load(a_block_ptr, boundary_check=(0, 1))
   135          b = tl.load(b_block_ptr, boundary_check=(0, 1))
   136          
   137          # 矩阵乘加
   138          accumulator += tl.dot(a, b)
   139      
   140      # 存储结果
   141      c_block_ptr = tl.make_block_ptr(
   142          base=c_ptr, shape=(M, N), strides=(stride_cm, stride_cn),
   143          offsets=(pid_m [3m* BLOCK_SIZE_M, pid_n *[0m BLOCK_SIZE_N),
   144          block_shape=(BLOCK_SIZE_M, BLOCK_SIZE_N), order=(1, 0)
   145      )
   146      tl.store(c_block_ptr, accumulator, boundary_check=(0, 1))
   147  ```
   148  
   149  ### 1.6 Autotune 使用
   150  
   151  Triton 支持 `autotune` 自动调优，但 [1;3m**[0m[1mAscend NPU 不支持 [0m
[1m`num_warps`、`num_ctas`、`num_stages` 等 CUDA 专用调优参数[0m[1;3m**[0m。在 Ascend 
上主要调优：
   152  
   153  - `BLOCK_SIZE` / `XBLOCK` / `XBLOCK_SUB` 等分块参数
   154  - `grid` 维度（核数）
   155  
   156  ```python
   157  @triton.autotune(
   158       configs=[
   159          triton.Config({'BLOCK_SIZE_M': 128, 'BLOCK_SIZE_N': 128, 
'BLOCK_SIZE_K': 128}),
   160          triton.Config({'BLOCK_SIZE_M': 64, 'BLOCK_SIZE_N': 64, 
'BLOCK_SIZE_K': 64}),
   161      ],
   162      key=['M', 'N', 'K'],  # 当这些参数变化时触发重新autotune
   163  )
   164  @triton.jit
   165  ddef matmul_kernel(
   166      a_ptr, b_ptr, c_ptr,
   167      M, N, K,
   168      stride_am, stride_ak, stride_bk, stride_bn, stride_cm, stride_cn,
   169      BLOCK_SIZE_M: tl.constexpr, # configs中的参数必须声明为constexpr
   170      BLOCK_SIZE_N: tl.constexpr, # configs中的参数必须声明为constexpr
   171      BLOCK_SIZE_K: tl.constexpr, # configs中的参数必须声明为constexpr
   172  ):
   173      # kernel实现
   174      pass
   175  
   176  class ModelNew(torch.nn.Module):
   177      def __init__(self):
   178          super().__init__()
   179  
   180      def forward(self, a, b):
   181      M, K = a.shape
   182      K, N = b.shape
   183      c = torch.empty((M, N), device=a.device, dtype=a.dtype)
   184      
   185      grid = lambda meta: (triton.cdiv(M, meta['BLOCK_SIZE_M']) * 
triton.cdiv(N, meta['BLOCK_SIZE_N']),) # grid设置是tuple
   186      
   187      # 关键：调用时不要传递configs中的参数（BLOCK_SIZE_M等）
   188      matmul_kernel[grid](
   189          a, b, c,
   190          M, N, K,
   191          a.stride(0), a.stride(1),
   192          b.stride(0), b.stride(1),
   193          c.stride(0), c.stride(1),
   194          # 不要写：BLOCK_SIZE_M=128  # 错误！autotune会自动传入
   195      )
   196      return c
   197  ```
