   172  def _get_subscript_value_name(node):
   173      """从 kernel[grid](...) 的 Subscript 节点提取 kernel 名称。"""
   174      if isinstance(node, ast.Subscript):
   175          if isinstance(node.value, ast.Name):
   176              return node.value.id
   177          if isinstance(node.value, ast.Attribute):
   178              if isinstance(node.value.value, ast.Name):
   179                  return f"{node.value.value.id}.{node.value.attr}"
   180      return None
