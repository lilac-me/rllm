   553  ### A.6 完整 GELU 示例
   554  
   555  ```python
   556  import triton
   557  import triton.language as tl
   558  import torch
   559  
   560  @triton.jit
   561  def triton_easy_kernel(in_ptr0, out_ptr0, NUMEL: tl.constexpr):
   562      idx_block = tl.arange(0, NUMEL)
   563      x = tl.load(in_ptr0 + idx_block)
   564      ret = x * 0.5 * (1.0 + tl.erf(x / tl.sqrt(2.0)))
   565      tl.store(out_ptr0 + idx_block, ret)
   566  
   567  @triton.jit
   568  def triton_better_kernel(in_ptr0, out_ptr0, xnumel, XBLOCK: 
tl.constexpr, XBLOCK_SUB: tl.constexpr):
   569      xoffset = tl.program_id(0) * XBLOCK
   570      for xoffset_sub in range(0, XBLOCK, XBLOCK_SUB):
   571          x_index = xoffset + xoffset_sub + tl.arange(0, XBLOCK_SUB)[:]
   572          xmask = x_index < xnumel
   573          x = tl.load(in_ptr0 + x_index, xmask)
   574          ret = x * 0.5 * (1.0 + tl.erf(x / tl.sqrt(2.0)))
   575          tl.store(out_ptr0 + x_index, ret, xmask)
   576  
   577  # 调用示例
   578  ncore = 32
   579  xblock = 32768
   580  xblock_sub = 8192
   581  triton_better_kernel[ncore, 1, 1](x0, out1, x0.numel(), xblock, 
xblock_sub)
   582  ```
