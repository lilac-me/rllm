    84  def get_limit(data_type):
    85      """根据数据类型获取精度阈值 - 使用 2 的幂次方阈值（与 NPU Benchmark 
标准一致）
    86  
    87      参考文档: 精度对比方法.md
    88      数据类型: FLOAT16, BFLOAT16, FLOAT32, HiFloat32, FLOAT8 E4M3, FLOAT8
E5M2
    89      判定标准: MERE < threshold 且 MARE < 10 * threshold
    90  
    91      阈值表:
    92      | 数据类型      | 阈值 (2^n)      | 十进制值       |
    93      |--------------|----------------|---------------|
    94      | FLOAT16      | 2^{-10}        | 0.0009765625  |
    95      | BFLOAT16     | 2^{-7}         | 0.0078125     |
    96      | FLOAT32      | 2^{-13}        | 0.0001220703  |
    97      | HiFloat32    | 2^{-11}        | 0.0004882812  |
    98      | FLOAT8 E4M3  | 2^{-3}         | 0.125         |
    99      | FLOAT8 E5M2  | 2^{-2}         | 0.25          |
   100  
   101      由于 torch.dtype 中没有直接定义 HiFloat32，可通过字符串传入 
"hifloat32" 获取对应阈值。
   102      """  # noqa: E501
   103      import torch
   104  
   105      # 支持字符串类型（用于 HiFloat32 或其他自定义类型）
   106      if isinstance(data_type, str):
   107          str_to_threshold = {
   108              "float16": 2**(-10),
   109              "bfloat16": 2**(-7),
   110              "float32": 2**(-13),
   111              "hifloat32": 2**(-11),
   112              "float8_e4m3": 2**(-3),
   113              "float8_e5m2": 2**(-2),
   114              "fp8_e4m3": 2**(-3),
   115              "fp8_e5m2": 2**(-2),
   116          }
   117          return str_to_threshold.get(data_type.lower(), 2**(-13))
   118  
   119      # torch.dtype 类型映射
   120      dtype_threshold_map = {
   121          torch.float16: 2**(-10),    # FLOAT16
   122          torch.bfloat16: 2**(-7),    # BFLOAT16
   123          torch.float32: 2**(-13),    # FLOAT32
   124      }
   125  
   126      # 安全获取 FP8 类型（PyTorch 2.0+ 支持）
   127      # FLOAT8 E4M3: 2^{-3}
   128      float8_e4m3 = getattr(torch, 'float8_e4m3fn', None) or 
getattr(torch, 'float8_e4m3', None)
   129      if float8_e4m3 is not None:
   130          dtype_threshold_map[float8_e4m3] = 2**(-3)
   131  
   132      # FLOAT8 E5M2: 2^{-2}
   133      float8_e5m2 = getattr(torch, 'float8_e5m2fn', None) or 
getattr(torch, 'float8_e5m2', None)
   134      if float8_e5m2 is not None:
   135          dtype_threshold_map[float8_e5m2] = 2**(-2)
   136  
   137      return dtype_threshold_map.get(data_type, 2**(-13))
   138  
