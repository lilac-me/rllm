    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    
    @triton.jit
    def add_kernel(
        x_ptr,
        y_ptr,
        out_ptr,
        numel: tl.constexpr,
        alpha,
        BLOCK_SIZE: tl.constexpr,
    ):
        pid = tl.program_id(0)
        offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
        mask = offsets < numel
    
        x_val = tl.load(x_ptr + offsets, mask=mask)
        y_val = tl.load(y_ptr + offsets, mask=mask)
    
        out_val = x_val + alpha * y_val
    
        tl.store(out_ptr + offsets, out_val, mask=mask)
    
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x: torch.Tensor, y: torch.Tensor, alpha: float = 1.0) 
-> torch.Tensor:
            # Broadcast y to x's shape (shape operation, not computation — 
allowed)
            if x.shape != y.shape:
                y = torch.broadcast_to(y, x.shape)
    
            # Make contiguous and flatten to 1D for kernel
            x_flat = x.contiguous().view(-1)
            y_flat = y.contiguous().view(-1)
            numel = x_flat.numel()
    
            # Allocate output
            out = torch.empty_like(x)
    
            # Launch kernel
            BLOCK_SIZE = 1024
            grid = (triton.cdiv(numel, BLOCK_SIZE),)
            add_kernel[grid](x_flat, y_flat, out, numel, alpha, 
BLOCK_SIZE=BLOCK_SIZE)
    
            return out
    

