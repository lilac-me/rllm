    import torch
    import torch.nn as nn
    import triton
    import triton.language as tl
    
    
    @triton.jit
    def groupnorm_kernel(
        input_ptr,
        weight_ptr,
        bias_ptr,
        output_ptr,
        N,
        C,
        num_groups,
        eps,
        BLOCK_SIZE: tl.constexpr,
    ):
        pid = tl.program_id(0)
    
        # Each program handles one (n, g) group
        n = pid // num_groups
        g = pid % num_groups
    
        group_channels = C // num_groups
        # Compute spatial size: total_elements / (N * C)
        # We'll get it from the total numel
        # spatial_size = (C // num_groups) is not right, let me think again
        # Input shape: [N, C, *] where * is spatial dims
        # group_size = (C / num_groups) * spatial_size
        # We need spatial_size = group_size / (C / num_groups)
        # But we don't know group_size directly...
        # Actually, we can compute it: total_elements = N * C * spatial_size
        # group_size = (C / num_groups) * spatial_size = total_elements / (N * 
num_groups)
        # But we don't have total_elements either...
        # Let me pass spatial_size as a parameter instead
    
        # Actually, let me restructure: pass spatial_size and group_size
        pass
    
    
    @triton.jit
    def groupnorm_kernel_v2(
        input_ptr,
        weight_ptr,
        bias_ptr,
        output_ptr,
        N,
        C,
        num_groups,
        spatial_size,
        group_size,
        eps,
        BLOCK_SIZE: tl.constexpr,
    ):
        pid = tl.program_id(0)
    
        # Each program handles one (n, g) group
        n = pid // num_groups
        g = pid % num_groups
    
        # Base offset for this (n, g) group in the flattened input
        base_offset = n * C * spatial_size + g * group_size
    
        # Offsets within this group
        offsets = base_offset + tl.arange(0, BLOCK_SIZE)
        mask = offsets < (N * C * spatial_size)
    
        # Load input data
        x = tl.load(input_ptr + offsets, mask=mask, other=0.0)
    
        # Convert to float32 for numerical stability in reduction
        x_f32 = x.to(tl.float32)
    
        # Compute mean
        mean = tl.sum(x_f32, axis=0) / group_size
    
        # Compute variance
        x_centered = x_f32 - mean
        variance = tl.sum(x_centered * x_centered, axis=0) / group_size
    
        # Normalize
        rstd = 1.0 / tl.sqrt(variance + eps)
        normalized = x_centered * rstd
    
        # Convert back to original dtype
        normalized = normalized.to(x.dtype)
    
        # Apply weight and bias
        # Channel index within the group: offsets_in_group // spatial_size
        # Global channel index: g * group_channels + channel_idx_in_group
        # offsets_in_group = offsets - base_offset
        # channel_idx_in_group = offsets_in_group // spatial_size
        # global_channel = g * (C // num_groups) + channel_idx_in_group
    
        offsets_in_group = offsets - base_offset
        channel_idx_in_group = offsets_in_group // spatial_size
        global_channel = g * (C // num_groups) + channel_idx_in_group
    
        w = tl.load(weight_ptr + global_channel, mask=mask, other=1.0)
        b = tl.load(bias_ptr + global_channel, mask=mask, other=0.0)
    
        output = normalized * w + b
    
        tl.store(output_ptr + offsets, output, mask=mask)
    
    
    class ModelNew(nn.Module):
        def __init__(self):
            super().__init__()
    
        def forward(self, x: torch.Tensor, num_groups: int, weight: torch.Tensor
= None, bias: torch.Tensor = None) -> torch.Tensor:
            N, C = x.shape[0], x.shape[1]
            spatial_size = x.numel() // (N * C)
            group_size = (C // num_groups) * spatial_size
            total_elements = x.numel()
    
            output = torch.empty_like(x)
    
            # Default weight and bias if not provided
            if weight is None:
                weight = torch.ones(C, dtype=x.dtype, device=x.device)
            if bias is None:
                bias = torch.zeros(C, dtype=x.dtype, device=x.device)
    
            eps = 1e-5
    
            # Grid: one program per (n, g) group
            num_groups_total = N * num_groups
            BLOCK_SIZE = triton.next_power_of_2(group_size)
            if BLOCK_SIZE < 1:
                BLOCK_SIZE = 1
            if BLOCK_SIZE > 65536:
                BLOCK_SIZE = 65536
    
            grid = (num_groups_total,)
            groupnorm_kernel_v2[grid](
                x,
                weight,
                bias,
                output,
                N,
                C,
                num_groups,
                spatial_size,
                group_size,
                eps,
                BLOCK_SIZE=BLOCK_SIZE,
            )
    
            return output
    

